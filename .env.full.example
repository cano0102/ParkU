# Copiar como .env junto a docker-compose.full.yml y completar.

# Base de datos (Neon Postgres u otra Postgres accesible desde donde corras Docker)
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=require

# JWT (mínimo 32 caracteres aleatorios en producción)
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# CORS: origen del frontend (por defecto http://localhost:8080 si usas el puerto de abajo)
CORS_ORIGIN=http://localhost:8080

# Rate limiting (opcional, tiene defaults)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1500

# Frontend: URL pública de la API vista desde el navegador
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=60000
